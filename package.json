{
  "name": "toca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:response-store": "wrangler deploy --config wrangler.response-store.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^0.1.0-beta.2",
    "@vinext/cloudflare": "^1.0.0-beta.10",
    "fflate": "^0.8.3",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vinext": "^1.0.0-beta.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "^5",
    "vite": "^8.3.3"
  },
  "type": "module",
  "overrides": {
    "@cloudflare/vite-plugin": {
      "wrangler": "4.153.0",
      "miniflare": "5.20261023.0-beta"
    }
  }
}
